---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

// Sort by date descending and group by year
const sortedPosts = posts
  .filter(post => !post.data.draft)
  .sort((a, b) => {
    const dateA = a.data.pubDate || new Date(0);
    const dateB = b.data.pubDate || new Date(0);
    return dateB.getTime() - dateA.getTime();
  });

// Group posts by year
const postsByYear = sortedPosts.reduce((acc, post) => {
  const year = post.data.pubDate?.getFullYear() || new Date().getFullYear();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<string | number, typeof sortedPosts>);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));

function extractTitle(post: typeof posts[0]): string {
  if (post.data.title) return post.data.title;
  const match = post.body?.match(/^#\s+(.+)$/m);
  if (match) return match[1];
  return post.id.replace(/-/g, ' ').replace(/\.md$/, '');
}

function formatDate(date: Date | undefined): string {
  if (!date) return '';
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric'
  });
}
---

<BaseLayout title="Blog">
  <h1>Blog</h1>

  {years.map(year => (
    <section class="year-section">
      <h2>{year}</h2>
      <ul class="post-list">
        {postsByYear[year].map(post => (
          <li class="post-item">
            <a href={`/${post.id}/`}>
              <time datetime={post.data.pubDate?.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span class="post-title">{extractTitle(post)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  h1 {
    font-size: 1.75rem;
    margin-bottom: 2rem;
  }

  .year-section {
    margin-bottom: 2.5rem;
  }

  .year-section h2 {
    font-size: 1.25rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .post-list {
    list-style: none;
  }

  .post-item {
    border-bottom: 1px solid var(--border);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-item a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.5rem 0;
    color: var(--text);
    text-decoration: none;
  }

  .post-item a:hover .post-title {
    color: var(--accent);
  }

  time {
    color: var(--text-muted);
    font-size: 0.85rem;
    min-width: 4rem;
  }

  .post-title {
    flex: 1;
  }
</style>
